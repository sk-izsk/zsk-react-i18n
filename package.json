{
  "name": "zsk-react-i18n",
  "version": "0.0.4",
  "description": "Reusable typed i18n wrapper for React + i18next + react-i18next",
  "keywords": [
    "i18n",
    "i18next",
    "internationalization",
    "localization",
    "react",
    "react-i18next",
    "translations",
    "typescript"
  ],
  "homepage": "https://github.com/sk-izsk/zsk-react-i18n#readme",
  "bugs": {
    "url": "https://github.com/sk-izsk/zsk-react-i18n/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sk-izsk/zsk-react-i18n.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bunx tsc -p tsconfig.json",
    "lint": "oxlint . --config .oxlintrc.json",
    "lint:fix": "oxlint . --fix --config .oxlintrc.json",
    "format": "oxfmt . --config .oxfmtrc.json --write",
    "format:check": "oxfmt . --config .oxfmtrc.json --check",
    "typecheck": "bunx tsc --noEmit",
    "typecheck:types": "bunx tsc -p tsconfig.test.json",
    "test": "vitest",
    "clean": "rm -rf dist",
    "verify": "bun run format && bun run lint && bun run typecheck && bun run typecheck:types && bun test && bun run clean && bun run build && npm pack --dry-run",
    "prepublishOnly": "bun run verify",
    "publish:release": "npm publish",
    "release": "bun run verify && npm publish"
  },
  "dependencies": {
    "i18next": "^25.0.0",
    "react-i18next": "^16.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "jsdom": "^29.0.1",
    "oxfmt": "^0.40.0",
    "oxlint": "^0.17.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "packageManager": "bun@1.2.5"
}
